{
  "version": "1.2",
  "media": {
    "default_library": "repo_media",
    "libraries": [
      {
        "key": "repo_media",
        "label": "Repository media",
        "references": {
          "write": {
            "mode": "library_relative"
          },
          "allow_default_library_fallback": true
        },
        "limits": {
          "max_file_size_mb": 10
        },
        "driver": "git",
        "storage": {
          "root_path": "public"
        }
      }
    ]
  },
  "ssg_framework": "hugo",
  "frontmatter_format": "yaml",
  "publishing_mode": "editorial_workflow",
  "i18n": {
    "enabled": true,
    "locales": [
      "en",
      "de"
    ],
    "default_locale": "en",
    "prefix_default_locale": false
  },
  "collections": [
    {
      "name": "blog",
      "git_path": "/content/blog/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "i18n": {
        "enabled": true,
        "strategy": "path"
      },
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description"
        },
        {
          "name": "date",
          "type": "datetime",
          "label": "Date",
          "withTime": true
        },
        {
          "name": "lastmod",
          "type": "datetime",
          "label": "Lastmod",
          "withTime": true
        },
        {
          "name": "draft",
          "type": "boolean",
          "label": "Draft",
          "default": false
        },
        {
          "name": "tags",
          "type": "multiselect",
          "label": "Tags",
          "options": [
            "guide",
            "502 Bad Gateway"
          ],
          "color": "blue"
        },
        {
          "name": "og_image",
          "type": "image",
          "label": "Og image"
        },
        {
          "name": "outputs",
          "type": "multiselect",
          "label": "Outputs",
          "options": [
            "HTML",
            "AMP"
          ],
          "color": "blue"
        }
      ]
    },
    {
      "name": "quickstart",
      "git_path": "/content/quickstart/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "i18n": {
        "enabled": true,
        "strategy": "path"
      }
    },
    {
      "name": "docs",
      "git_path": "/content/docs/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "grouped"
    },
    {
      "name": "about",
      "git_path": "/content/about/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat"
    },
    {
      "name": "app",
      "git_path": "/content/app/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        }
      ]
    },
    {
      "name": "cli",
      "git_path": "/content/cli/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat"
    },
    {
      "name": "contact_us",
      "git_path": "/content/contact_us/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat"
    },
    {
      "name": "help",
      "git_path": "/content/help/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat"
    },
    {
      "name": "ingress_for_dev_test_environments",
      "git_path": "/content/ingress_for_dev_test_environments/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat"
    },
    {
      "name": "privacy_policy",
      "git_path": "/content/privacy_policy/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "date",
          "type": "datetime",
          "label": "Date",
          "withTime": true
        },
        {
          "name": "draft",
          "type": "boolean",
          "label": "Draft",
          "default": false
        }
      ]
    },
    {
      "name": "terms_of_service",
      "git_path": "/content/terms_of_service/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "date",
          "type": "datetime",
          "label": "Date",
          "withTime": true
        },
        {
          "name": "draft",
          "type": "boolean",
          "label": "Draft",
          "default": false
        }
      ]
    }
  ]
}
